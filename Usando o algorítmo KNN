        "# Classificar os vinhos conforme a nota de qualidade\n",
        "def classificar(qualidade):\n",
        "    if qualidade <= 4:\n",
        "        return \"Baixa\"\n",
        "    elif qualidade <= 6:\n",
        "        return \"Média\"\n",
        "    else:\n",
        "        return \"Alta\"\n",
        "\n",
        "# Adicionar a nova coluna ao dataset\n",
        "df[\"classificacao\"] = df[\"quality\"].apply(classificar)\n",
        "\n",
        "# Mostrar algumas linhas com a classificação\n",
        "df[[\"quality\", \"classificacao\"]].head(10)"
